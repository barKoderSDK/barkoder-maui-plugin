<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst;net8.0-windows10.0.19041.0</TargetFrameworks>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
		<CheckEolTargetFramework>false</CheckEolTargetFramework>
		<UseMaui>true</UseMaui>
		<Authors>Barkoder</Authors>
		<Description>The barKoder SDK Maui plugin grants an easy to use Maui solution with a great interface that can be integrated in both iOS and Android apps and Windows. Integrating the barKoder Barcode Scanner SDK into your Enterprise or Consumer-facing mobile apps will instantly transform your user's smartphones and tablets into rugged barcode scanning devices without the need to procure and maintain expensive and sluggish hardware devices that have a very short life span.</Description>
		<Copyright>Copyright @2023 Barkoder</Copyright>
		<PackageProjectUrl>https://barkoder.com</PackageProjectUrl>
		<PackageTags>barkoder,bkd,maui,android,ios,windows,native,scanner,barcode</PackageTags>
		<PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>

<MauiImplicitPackageReferences>true</MauiImplicitPackageReferences>

		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AndroidErrorOnCustomJavaObject>false</AndroidErrorOnCustomJavaObject>
		<AndroidLinkResources>false</AndroidLinkResources>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<Version>43.23.53</Version>
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
		<SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<NuspecFile>Plugin.Maui.Barkoder.nuspec</NuspecFile>
		<NuspecProperties>version=$(Version);configuration=$(Configuration)</NuspecProperties>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0-ios|AnyCPU'">
	  <CreatePackage>false</CreatePackage>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)'=='net8.0-android'">
  <Reference Include="BarkoderBindingMauiAndroid">
    <HintPath>lib/BarkoderBindingMauiAndroid.dll</HintPath>
  </Reference>
</ItemGroup>

<ItemGroup Condition="'$(TargetFramework)'=='net8.0-ios'">
	<Reference Include="BarkoderBindingMauiiOS">
		<HintPath>lib/BarkoderBindingMauiiOS.dll</HintPath>
	</Reference>
</ItemGroup>

<ItemGroup Condition="'$(TargetFramework)'=='net8.0-maccatalyst'">
	<Reference Include="BarkoderBindingMauiiOS.MacCatalyst">
		<HintPath>$(MSBuildThisFileDirectory)lib/BarkoderBindingMauiiOS-maccatalyst.dll</HintPath>
	</Reference>
</ItemGroup>

<ItemGroup Condition="'$(TargetFramework)'=='net8.0-windows10.0.19041.0'">
	  <Reference Include="BarkoderSDK">
    <HintPath>lib/BarkoderSDK.dll</HintPath>
  </Reference>
</ItemGroup>

	<ItemGroup>
		<None Include="lib\BarkoderBindingMauiAndroid.dll" Pack="true" PackagePath="\lib\net8.0-android34.0" />
		<None Include="lib\BarkoderBindingMauiiOS.dll" Pack="true" PackagePath="\lib\net8.0-ios18.0" />
		<None Include="lib\BarkoderBindingMauiiOS-maccatalyst.dll" Pack="true" PackagePath="\lib\net8.0-maccatalyst18.0\BarkoderBindingMauiiOS.dll" />
		<None Include="lib\BarkoderSDK.dll" Pack="true" PackagePath="\lib\net8.0-windows10.0.19041.0" />
	 <None Include="..\Bindings\BarkoderBindingMauiiOS\BarkoderBindingMauiiOS\bin\$(Configuration)\net8.0-ios\BarkoderBindingMauiiOS.resources\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Pack>true</Pack>
        <PackagePath>lib/net8.0-ios18.0/BarkoderBindingMauiiOS.resources/</PackagePath>
    </None>
	 <None Include="..\Bindings\BarkoderBindingMauiiOS\BarkoderBindingMauiiOS\bin\$(Configuration)\net8.0-maccatalyst\BarkoderBindingMauiiOS.resources\**">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Pack>true</Pack>
        <PackagePath>lib/net8.0-maccatalyst18.0/BarkoderBindingMauiiOS.resources/</PackagePath>
    </None>
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Handlers\" />
	  <None Remove="Common\" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Handlers\" />
	  <Folder Include="Common\" />
	</ItemGroup>

	<ItemGroup>
        <None Include="docs\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>
</Project>
